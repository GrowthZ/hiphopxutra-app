rules_version = '2';

// Organizers: Google or BTC username accounts listed in events/{eventId}/admins/{email} with a role:
//   'admin' (or no role) = everything; 'checkin' = check-in desk: read dancers, check in, register walk-ins.
// Judges: email/password accounts gk-N@giamkhao.hiphopxutra.vn (see src/services/judgeAccounts.ts);
//         each judge may only write their own prelim score / battle vote, never other judges'.
// LED PC: anonymous session, heartbeat only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      function staffEntry() {
        return /databases/$(database)/documents/events/$(eventId)/admins/$(request.auth.token.email.lower());
      }

      // BTC accounts (email/password on the made-up btc.hiphopxutra.vn domain) can't verify their email;
      // only an admin creates them, and they still need an entry in admins/.
      function isStaff() {
        return request.auth != null
          && request.auth.token.email is string
          && (request.auth.token.email_verified == true
            || request.auth.token.email.matches('^[a-z0-9._-]+@btc[.]hiphopxutra[.]vn$'))
          && exists(staffEntry());
      }

      function isAdmin() {
        return isStaff() && get(staffEntry()).data.get('role', 'admin') == 'admin';
      }

      // Check-in desk: hand out an SBD and the prelim panel, mark arrival; nothing else on an existing dancer.
      function validCheckIn() {
        return isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sbd', 'checkedInAt', 'panel'])
          && request.resource.data.get('panel', 'A') in ['A', 'B'];
      }

      // Walk-in registration: a fresh, unscored dancer with only the desk's fields.
      function validWalkIn(category) {
        let d = request.resource.data;
        return isStaff()
          && d.keys().hasOnly(['sbd', 'name', 'realName', 'crew', 'gender', 'category', 'prelimScores'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.sbd == '' && d.prelimScores == {} && d.category == category
          && d.gender in ['male', 'female'];
      }

      function isJudge() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.matches('^gk-[0-9]+@giamkhao[.]hiphopxutra[.]vn$');
      }

      function judgeId() {
        return request.auth.token.email.split('@')[0];
      }

      function eventData(collection, id) {
        return get(/databases/$(database)/documents/events/$(eventId)/$(collection)/$(id)).data;
      }

      // Prelim: 8 judges in two panels of 4 (meta/current.prelimPanels). Each dancer has the panel given at check-in
      // (dancer.panel; older docs fall back to their SBD's parity). A judge writes only their own score, 0-100, for a
      // checked-in dancer of their panel, while Top 32 isn't locked.
      function panelJudges(meta) {
        let panels = meta.get('prelimPanels', {
          'A': ['gk-1', 'gk-2', 'gk-3', 'gk-4'], 'B': ['gk-5', 'gk-6', 'gk-7', 'gk-8'], 'aIsOdd': true
        });
        let odd = resource.data.sbd.matches('.*[13579]$');
        let panel = resource.data.get('panel', odd == panels.get('aIsOdd', true) ? 'A' : 'B');
        return panel == 'A' ? panels.A : panels.B;
      }

      function validOwnPrelimScore(lockField) {
        let before = resource.data.get('prelimScores', {});
        let after = request.resource.data.prelimScores;
        let meta = eventData('meta', 'current');
        return isJudge()
          && resource.data.get('sbd', '') is string
          && resource.data.get('sbd', '').matches('.*[0-9]$')
          && judgeId() in panelJudges(meta)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prelimScores'])
          && after.diff(before).affectedKeys().hasOnly([judgeId()])
          && after[judgeId()] is number
          && after[judgeId()] >= 0 && after[judgeId()] <= 100
          && meta.get(lockField, false) == false;
      }

      // Battle: votes/{matchId} = { r1: { gk-1: 'red', ... }, ... }. A judge changes one round,
      // only their own key, only while that round isn't announced and the match isn't finished.
      // Rules have no loops and a Set can't be indexed, so each possible round key (r1-r5) is checked on its own.
      function validRoundVote(key, before, battle) {
        let afterRound = request.resource.data[key];
        let round = battle.rounds[int(key.replace('r', '')) - 1];
        return afterRound.diff(before.get(key, {})).affectedKeys().hasOnly([judgeId()])
          && afterRound[judgeId()] in ['red', 'blue']
          && round.get('isConfirmed', false) == false;
      }

      function validOwnVote(matchId) {
        let before = resource == null ? {} : resource.data;
        let changed = request.resource.data.diff(before).affectedKeys();
        let battle = eventData('matches', matchId);
        return isJudge()
          && changed.size() == 1
          && changed.hasOnly(['r1', 'r2', 'r3', 'r4', 'r5'])
          && battle.status != 'finished'
          && (!changed.hasAny(['r1']) || validRoundVote('r1', before, battle))
          && (!changed.hasAny(['r2']) || validRoundVote('r2', before, battle))
          && (!changed.hasAny(['r3']) || validRoundVote('r3', before, battle))
          && (!changed.hasAny(['r4']) || validRoundVote('r4', before, battle))
          && (!changed.hasAny(['r5']) || validRoundVote('r5', before, battle));
      }

      // Admin whitelist: each admin can see their own entry.
      match /admins/{email} {
        allow read: if request.auth != null && request.auth.token.email.lower() == email;
        allow write: if isAdmin();
      }

      // Guests, the LED and judges read only what is public: the bracket, LED state and the published copies
      // (publicDancers / publicVotes, kept in step by an admin client). Raw scores and votes are admin-only,
      // so unfinished prelim scores and unrevealed votes never leak (KG-06) and judges score independently (GK-09).
      // Everything is admin-only to write, apart from the judge/LED rules below.
      match /{collection}/{docId} {
        allow read: if collection in ['teams', 'matches', 'judges', 'meta', 'screens', 'presence', 'publicDancers', 'publicVotes']
          || isAdmin();
        allow write: if isAdmin();
      }

      // A judge reads back only their own scores and votes (published by an admin client).
      match /judgeBallots/{id} {
        allow read: if isJudge() && judgeId() == id;
      }

      match /newbieDancers/{dancerId} {
        allow read: if isStaff();
        allow create: if validWalkIn('newbie_1v1');
        allow update: if validOwnPrelimScore('isNewbieTop32Locked') || validCheckIn();
      }

      match /proDancers/{dancerId} {
        allow read: if isStaff();
        allow create: if validWalkIn('pro_2v2');
        allow update: if validOwnPrelimScore('isProTop32Locked') || validCheckIn();
      }

      // SBD counter, shared by every check-in desk (transaction in checkInDancer).
      match /counters/sbd {
        allow read, write: if isStaff();
      }

      match /votes/{matchId} {
        allow create, update: if validOwnVote(matchId);
      }

      // A judge claims their session (a newer login signs other devices out) and sends a heartbeat.
      match /judgeSessions/{id} {
        allow read, write: if isJudge() && judgeId() == id;
      }

      match /judgePresence/{id} {
        allow write: if isJudge() && judgeId() == id && request.resource.data.keys().hasOnly(['lastSeen']);
      }

      // LED heartbeat (anonymous session on the LED PC); screens/{screenId} itself is admin-only.
      match /presence/{screenId} {
        allow write: if request.auth != null && request.resource.data.keys().hasOnly(['lastSeen']);
      }
    }
  }
}
